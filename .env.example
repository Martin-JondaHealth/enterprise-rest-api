# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/enterprise_db?schema=public"

# Redis (Caching & Rate Limiting)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Authentication & Security
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production-min32"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-min32"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
